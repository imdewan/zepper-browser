{
  "name": "zepper-browser",
  "productName": "Zepper",
  "version": "0.1.4",
  "private": true,
  "description": "A calm macOS browser with Spaces, a vertical sidebar and built-in privacy protections. Built on Electron, so you can make it your own without compiling Chromium.",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/imdewan/zepper-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/imdewan/zepper-browser.git"
  },
  "bugs": {
    "url": "https://github.com/imdewan/zepper-browser/issues"
  },
  "author": "Dewan Shakil",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && prettier --check .",
    "dist": "electron-vite build && npm run build:native && node scripts/stage-electron.mjs && electron-builder --mac && cp dist/latest-mac.yml dist/Zepper-update-mac.yml",
    "dist:browser": "node scripts/dist-browser.mjs",
    "brand:dev": "node scripts/brand-dev-runtime.mjs",
    "build:native": "mkdir -p build/bin && swiftc -O -parse-as-library -swift-version 5 -target arm64-apple-macos26.0 native/zepper-ai/main.swift -o build/bin/zepper-ai && npm run build:credentials",
    "build:credentials": "node-gyp rebuild -C native/credentials --arch=arm64 && mkdir -p build/bin && rm -f build/bin/zepper_credentials.node && cp native/credentials/build/Release/zepper_credentials.node build/bin/",
    "vmp:signup": ".evs/bin/python -m castlabs_evs.account signup",
    "vmp:login": ".evs/bin/python -m castlabs_evs.account reauth",
    "vmp:sign": ".evs/bin/python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "vmp:verify": ".evs/bin/python -m castlabs_evs.vmp verify-pkg node_modules/electron/dist"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "tldts-experimental": "^7.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "prettier": "^3.9.9",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "github:castlabs/electron-releases#9b90904e4fe174122b99eca5b7b967aa79681cc6": true
  },
  "build": {
    "appId": "app.zepper.browser",
    "productName": "Zepper",
    "electronDist": "node_modules/.cache/zepper-electron-dist",
    "afterPack": "scripts/after-pack.cjs",
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "name": "Web page",
        "ext": [
          "html",
          "htm",
          "xhtml",
          "shtml"
        ],
        "role": "Viewer"
      },
      {
        "name": "PDF document",
        "ext": [
          "pdf"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "extraResources": [
      {
        "from": "build/bin/zepper-ai",
        "to": "bin/zepper-ai"
      },
      {
        "from": "build/bin/zepper_credentials.node",
        "to": "bin/zepper_credentials.node"
      },
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationWhenInUseUsageDescription": "Websites you allow can use your location.",
        "NSLocationUsageDescription": "Websites you allow can use your location.",
        "NSBluetoothAlwaysUsageDescription": "Zepper uses Bluetooth to check your phone is nearby when you sign in with a passkey from it.",
        "NSAudioCaptureUsageDescription": "When you share a window or your screen, Zepper can share your Mac’s audio too.",
        "CFBundleIconName": "AppIcon"
      },
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName}",
      "background": "build/background.tiff",
      "iconSize": 96,
      "window": {
        "width": 660,
        "height": 428
      },
      "contents": [
        {
          "x": 180,
          "y": 160,
          "type": "file"
        },
        {
          "x": 480,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
