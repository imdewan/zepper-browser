{
  "name": "zepper-browser",
  "productName": "Zepper",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, beautiful browser with Spaces and built-in ad blocking.",
  "author": "Dewan Shakil",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && prettier --check .",
    "dist": "electron-vite build && electron-builder --mac",
    "brand:dev": "node scripts/brand-dev-runtime.mjs",
    "vmp:signup": ".evs/bin/python -m castlabs_evs.account signup",
    "vmp:login": ".evs/bin/python -m castlabs_evs.account reauth",
    "vmp:sign": ".evs/bin/python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "vmp:verify": ".evs/bin/python -m castlabs_evs.vmp verify-pkg node_modules/electron/dist"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "tldts-experimental": "^7.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "motion": "^14.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "github:castlabs/electron-releases#9b90904e4fe174122b99eca5b7b967aa79681cc6": true
  },
  "build": {
    "appId": "app.zepper.browser",
    "productName": "Zepper",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/vmp-sign.cjs",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
